    ### DELETE ###        
    def delete(self, 
               app_name: str):
        """
        Delete a Shiny application deployment
        """
        self._check_app_exists(app_name)
        
        confirm = input(
            f"{bcolors.WARNING}Are you sure you want to " +
            f"{bcolors.UNDERLINE}delete{bcolors.ENDC}{bcolors.WARNING}" +
            f" '{app_name}'? (y/N):{bcolors.ENDC} "
        )

        if confirm.lower() != 'y':
            print("Deletion cancelled.")
            return
        else:
            print(f"Deleting Cloud Run service for {app_name}...")
            image_uri = get_container_for_service(app_name)
            if image_uri.startswith('gcr.io'):
                subprocess.run([
                    "gcloud", "container", "images", 
                    "delete", image_uri, "--quiet",
                    "--force-delete-tags"
                ], check=True)
            subprocess.run([
                "gcloud", "run", "services", 
                "delete", f"{app_name}",
                "--region", REGION,
                "--quiet"
            ], check=True)
        print(f"✅ Successfully deleted '{app_name}'!")
    
    ### LOGS ###
    def logs(self, app_name: str, last: Optional[int] = None):
        """View logs for a Shiny application"""
        self._check_app_exists(app_name)
        try:
            print(f"Fetching logs for {app_name}...")
            last_limit = f"--limit={last}" if last else "--limit=50"
            subprocess.run([
                "gcloud", "logging", "read",
                f"resource.type=cloud_run_revision AND resource.labels.service_name={app_name}",
                last_limit,
            ], check=True)
        except subprocess.CalledProcessError as e:
            print(f"Error fetching logs: {str(e)}")
            return


def main():
    """
    Main entry point for the command-line interface
    """
    parser = argparse.ArgumentParser(
        description="CLI tool for deploying Shiny applications to Google Cloud Platform and Posit Connect",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog= dedent("""
                Examples:
                Deploy a new application to GCP:
                    {0} create my-app ./my-app-dir

                List all deployed applications:
                    {0} read

                Get details about a specific application:
                    {0} read my-app

                Update an application:
                    {0} update my-app ./updated-app-dir

                Delete an application:
                    {0} delete my-app

                View application logs:
                    {0} logs my-app

                Deploy to Posit Connect with direct arguments:
                    {0} posit --username user --api-key KEY --server https://connect.example.com --app-dir ./my-app

                Deploy to Posit Connect with JSON config:
                    {0} posit --config config.json

                Deploy to Posit Connect with config and overrides:
                    {0} posit --config config.json --app-dir ./different-app
                """.format(CLI_MAIN_ENTRY_POINT))
    )

    subparsers = parser.add_subparsers(dest="command", help="Command to execute")
    
    # Create command
    # TODO: resources for VM
    create_parser = subparsers.add_parser("create", help="Create a new Shiny application deployment")
    create_parser.add_argument("app_name", type=app_name_valid, help="Name of the application to deploy on the `openomics-gcp` project")
    create_parser.add_argument("docker", help="Dockerfile or to use for shiny application")
    create_parser.add_argument("artifacts", help="File containing the mapping between Dockerfile")
    create_parser.add_argument("--cloud", action='store_true', default=False, required=False, help="File containing the mapping between Dockerfile")
    create_parser.add_argument("--max-cpu", dest='maxcpu', required=False, default=2, help="Maximum number of CPUs to use for application (Default 2 CPU)")
    create_parser.add_argument("--max-memory", dest='maxmem', required=False, default=4, help="Maximum number of memory (in gigabytes) to use for application (Default 4GiB)")
    
    
    # Read command
    read_parser = subparsers.add_parser("read", help="Read information about deployed apps")
    read_parser.add_argument("app_name", nargs="?", default=None, help="Name of the application to get details for")
    
    # Update command
    update_parser = subparsers.add_parser("update", help="Update an existing Shiny application deployment")
    update_parser.add_argument("app_name", help="Name of the application")
    update_parser.add_argument("docker", help="Dockerfile or to use for shiny application")
    update_parser.add_argument("artifacts", help="File containing the mapping between Dockerfile")
    update_parser.add_argument("--cloud", action='store_true', default=False, required=False, help="File containing the mapping between Dockerfile")
    update_parser.add_argument("--max-cpu", dest='maxcpu', required=False, default=2, help="Maximum number of CPUs to use for application (Default 2 CPU)")
    update_parser.add_argument("--max-memory", dest='maxmem', required=False, default=4, help="Maximum number of memory (in gigabytes) to use for application (Default 4GiB)")
    
    # Delete command
    delete_parser = subparsers.add_parser("delete", help="Delete a Shiny application deployment")
    delete_parser.add_argument("app_name", help="Name of the application")
    
    # Logs command
    logs_parser = subparsers.add_parser("logs", help="View logs for a Shiny application")
    logs_parser.add_argument("app_name", help="Name of the application")
    logs_parser.add_argument("--lastn", dest="lastn", help="Limit log entries to the last N entries")
    
    # Posit command
    posit_parser = subparsers.add_parser("posit", help="Deploy a Shiny application to Posit Connect")
    posit_parser.add_argument("--username", "-u", help="Posit Connect username")
    posit_parser.add_argument("--api-key", "-k", dest="api_key", help="Posit Connect API key")
    posit_parser.add_argument("--server", "-s", help="Posit Connect server URL (e.g., https://connect.example.com)")
    posit_parser.add_argument("--app-dir", "-d", dest="app_dir", help="Path to Shiny application directory")
    posit_parser.add_argument("--config", "-c", dest="config_file", help="Path to JSON configuration file (can override individual settings)")
    posit_parser.add_argument("--app-name", "-n", dest="app_name", help="Optional name for the application (defaults to directory name)")
    posit_parser.add_argument("--title", "-t", help="Optional title for the application")
    posit_parser.add_argument("--disable-ssl-verify", dest="disable_ssl_verify", action="store_true", 
                              help="Disable SSL certificate verification (use for self-signed certificates)")
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    # Handle posit command separately (doesn't need ShinyGCPDeploy instance)
    if args.command == "posit":
        posit_deploy_handler(
            username=args.username,
            api_key=args.api_key,
            server=args.server,
            app_dir=args.app_dir,
            config_file=args.config_file,
            app_name=args.app_name,
            title=args.title,
            disable_ssl_verify=getattr(args, 'disable_ssl_verify', False)
        )
        return
    
    deployer = ShinyGCPDeploy(args.cloud)
    
    if args.command == "create":
        if args.cloud:
            deployer.cloud_create(args.app_name, args.docker, args.artifacts, args.maxcpu, args.maxmem)
        else:
            deployer.create(args.app_name, args.docker, args.artifacts, args.maxcpu, args.maxmem)
    elif args.command == "update":
        if args.cloud:
            deployer.cloud_update(args.app_name, args.docker, args.artifacts, args.maxcpu, args.maxmem)
        else:
            deployer.update(args.app_name, args.docker, args.artifacts, args.maxcpu, args.maxmem)
    elif args.command == "read":
        deployer.read(args.app_name)
    elif args.command == "delete":
        deployer.delete(args.app_name)
    elif args.command == "logs":
        deployer.logs(args.app_name, args.lastn)


if __name__ == "__main__":
    main()