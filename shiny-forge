class ShinyGCPDeploy:
    """
    A brief summary of the class and its purpose.

    Longer description of the class, providing more details about its 
    functionality, usage, and any important considerations.
    """
    
    def __init__(self, cloud=False):
        """Initialize the deployment tool"""
        self.cloud = cloud
        urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
        # logging.captureWarnings(True)
        self._ensure_dependencies()
        self._check_gcloud_auth()
        self._check_gcloud_project()
        self._add_gcr_to_docker()
    
    def _ensure_dependencies(self):
        """Ensure all required dependencies are installed"""
        dependencies = ["gcloud", "docker"]
        
        for dep in dependencies:
            try:
                subprocess.run([dep, "--version"], 
                              stdout=subprocess.PIPE, 
                              stderr=subprocess.PIPE,
                              env=ENV, 
                              check=False)
            except (FileNotFoundError, PermissionError) as e:
                if dep == "gcloud":
                    logging.info(f"Error: {dep} not found. Please install it to use this tool.")
                    raise FileNotFoundError("Visit https://cloud.google.com/sdk/docs/install for installation instructions.") from e
                elif dep == "docker":
                    hostname = socket.gethostname()
                    if not re.match(r"cn[0-9]{4}", hostname):
                        logging.info(f"Error: {dep} not found. Please install it to use this tool.")
                        raise FileNotFoundError("Visit https://docs.docker.com/get-docker/ for installation instructions.") from e
                    else:
                        if getattr(self, 'cloud', False):
                            logging.info('Docker does not exist, but this is a biowulf compute node with cloud flag')
                        else:
                            raise ValueError('Using shiny-forge on biowulf only works when building docker images in the cloud! Please use --cloud')
    
    def _check_gcloud_auth(self):
        """Check if user is authenticated with gcloud"""
        try:
            result = subprocess.run(
                ["gcloud", "auth", "list", "--filter=status:ACTIVE", "--format=json"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=ENV,
                check=True,
                text=True
            )
            accounts = json.loads(result.stdout)
            if not accounts:
                print("You need to authenticate with Google Cloud.")
                subprocess.run(["gcloud", "auth", "login"], env=ENV, check=True)
        except subprocess.CalledProcessError:
            print("Error checking authentication. Please run 'gcloud auth login' manually.")
            sys.exit(1)
    
    def _check_gcloud_project(self):
        """Check if a Google Cloud project is set"""
        try:
            result = subprocess.run(
                ["gcloud", "config", "get-value", "project"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=ENV,
                check=True,
                text=True
            )
            # TODO: enforce that project is openomics-gcp !!!
            project = result.stdout.strip()
            if project != 'openomics-gcp':
                subprocess.run(["gcloud", "config", "set", "project", "openomics-gcp"], env=ENV, check=True)
            # TODO: check that you're on NIH GCP !!! 
            #   - gcloud projects get-ancestors openomics-gcp -> org_dict
            #   - 383772619975 == org_dict["organization"]
        except subprocess.CalledProcessError:
            print("Error checking GCP project. Please set a project with 'gcloud config set project PROJECT_ID'")
            sys.exit(1)
    
    def _add_gcr_to_docker(self):
        return subprocess.run(
            ["gcloud", "auth", "configure-docker", "--quiet", "gcr.io"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=ENV
        )

    # method helper functions 
    def _setup_tmp_for_docker_build(self, build_args, docker, artifacts_file, tmpdir):
        artifacts = read_artifacts(artifacts_file)
        dont_exist = []
        for arg in artifacts.keys():
            if arg not in build_args:
                dont_exist.append(arg)
        if dont_exist:
            _c = ', '.join(dont_exist)
            raise ValueError(f'BUILD-ARGs: {_c} are missing from the artifacts file')
        new_artifacts = artifacts.copy()
        for key, val in artifacts.items():
            if os.path.exists(val):
                shutil.copy(val, tmpdir)
                new_artifacts[key] = os.path.basename(val)
        shutil.copy(docker, tmpdir)
        bargs = []
        for key, val in new_artifacts.items():
            bargs.append('--build-arg')
            bargs.append(f'{key}={val}')

        return bargs

    def _check_app_exists(self, app_name):
        # LBYL validation
        apps = list_apps()
        if app_name not in apps:
            read_all()
            print("\n\n")
            raise ValueError(f'{app_name} does not exist in google cloud run services.')
        return

    ### CREATE ###
    def create(
            self, 
            app_name: str,
            docker: str,
            artifacts: str,
            maxcpu: int,
            maxmem: int
        ):
        """
        Create a new Shiny application deployment (local Docker build)
        """
        # Get project
        project_id = subprocess.run(
            ["gcloud", "config", "get-value", "project"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True,
            env=ENV,
            text=True
        ).stdout.strip()

        # Check if we can use optimized Dockerfile.prebuilt
        bargs_dict = read_artifacts(artifacts)
        has_shiny_files = 'SHINY_FILES' in bargs_dict and bargs_dict['SHINY_FILES'] != 'NA'
        
        if has_shiny_files:
            optimized_dockerfile = docker.replace('Dockerfile', 'Dockerfile.prebuilt')
            if os.path.exists(optimized_dockerfile):
                print("✨ Using optimized Dockerfile.prebuilt for pre-built shiny app")
                docker = optimized_dockerfile
                # Remove SEURAT_RDS and SEURAT_ASSAY from artifacts (not needed)
                bargs_dict = {k: v for k, v in bargs_dict.items() if k not in ['SEURAT_RDS', 'SEURAT_ASSAY']}
            else:
                print("⚠️  Dockerfile.prebuilt not found, using standard build")

        # Get docker build-args
        build_args = read_dockerfile(docker)
        
        # Docker image name
        image_name_base = f"gcr.io/{project_id}/{app_name}"
        tag = 'latest'
        image_name = f"{image_name_base}:{tag}"
        
        with TemporaryDirectory() as tmpdir:
            print(f"Building Docker image for {app_name}...")
            bargs = self._setup_tmp_for_docker_build(build_args, docker, artifacts, tmpdir)
            # Docker build image
            subprocess.run([
                "docker", "build", 
                "--progress=plain",
                "--platform", "linux/amd64", 
                "-t", image_name.lower(), 
                *bargs, 
                tmpdir
            ], env=ENV, check=True)
            # Deploy to GCP artifact registry
            print("Pushing Docker image to Google artifact registry...")
            subprocess.run(
                ["docker", "push", image_name.lower()],
                env=ENV,
                check=True
            )
            # Deploy to Cloud Run
            print("Deploying to Cloud Run...")
            subprocess.run([
                "gcloud", "run", "deploy", f"{app_name}",
                "--image", image_name.lower(),
                "--region", REGION,
                "--allow-unauthenticated",
                "--port", '8080',
                "--memory", f"{str(maxmem)}Gi",
                "--cpu", f"{str(maxcpu)}",
                "--concurrency", "80"
            ], env=ENV, check=True)
            # Get the URL
            url_result = run_and_grab([
                "gcloud", "run", "services",
                "describe", f"{app_name}",
                "--region", REGION,
                "--format=\"json\""
            ], True)
            url = json.loads(url_result['metadata']['annotations']['run.googleapis.com/urls'])[0]

        print(f"✅ Successfully deployed {app_name} to {url}")
            
        return 

    def cloud_create(
        self, 
