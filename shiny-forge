    ### READ ###
    def read(self, app_name: Optional[str] = None):
        """Read information about deployed apps"""
        if app_name is None:
            read_all()
        elif app_name:
            read_one(app_name)
        return
    
    ### UPDATE ###
    def update(
            self, 
            app_name: str,
            docker: str,
            artifacts: str,
            maxcpu: int,
            maxmem: int
        ):
        """
        Update an existing Shiny application deployment (local Docker build)
        """
        self._check_app_exists(app_name)
        
        project_id = subprocess.run(
            ["gcloud", "config", "get-value", "project"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True,
            env=ENV,
            text=True
        ).stdout.strip()
        
        # Check if we can use optimized Dockerfile.prebuilt
        bargs_dict = read_artifacts(artifacts)
        has_shiny_files = 'SHINY_FILES' in bargs_dict and bargs_dict['SHINY_FILES'] != 'NA'
        
        if has_shiny_files:
            optimized_dockerfile = docker.replace('Dockerfile', 'Dockerfile.prebuilt')
            if os.path.exists(optimized_dockerfile):
                print("✨ Using optimized Dockerfile.prebuilt for pre-built shiny app")
                docker = optimized_dockerfile
                # Remove SEURAT_RDS and SEURAT_ASSAY from artifacts (not needed)
                bargs_dict = {k: v for k, v in bargs_dict.items() if k not in ['SEURAT_RDS', 'SEURAT_ASSAY']}
            else:
                print("⚠️  Dockerfile.prebuilt not found, using standard build")
        
        # Setup docker buildx
        build_args = read_dockerfile(docker)
        image_name_base = f"gcr.io/{project_id}/{app_name}"
        tag = 'latest'
        image_name = f"{image_name_base}:{tag}"
        # Docker build, push, GCP update
        with TemporaryDirectory() as tmpdir:
            print(f"Building Docker image for {app_name}...")
            bargs = self._setup_tmp_for_docker_build(build_args, docker, artifacts, tmpdir)
            # Docker build image
            subprocess.run([
                "docker", "build", 
                "--platform", "linux/amd64", 
                "-t", image_name.lower(), 
                *bargs, tmpdir
            ], env=ENV, check=True)
            # Deploy to GCP artifact registry
            print("Pushing Docker image to Google artifact registry...")
            subprocess.run([
                "docker", "push", image_name.lower()
            ], env=ENV, check=True)
            # Update deployment
            print("Updating Cloud Run deployment...")
            subprocess.run([
                "gcloud", "run", "services", "update", f"{app_name}",
                "--image", image_name.lower(),
                "--allow-unauthenticated",
                "--port", '8080',
                "--memory", f"{str(maxmem)}Gi",
                "--cpu", f"{str(maxcpu)}",
                "--region", REGION
            ], env=ENV, check=True)
            # Get the URL
            url_result = subprocess.run([
                "gcloud", "run", "services", "describe", f"{app_name}",
                "--region", REGION,
                "--format", "value(status.url)"
            ], stdout=subprocess.PIPE, env=ENV, check=True, text=True)
            url = url_result.stdout.strip()
        print(f"✅ Successfully updated {app_name} at {url}")


