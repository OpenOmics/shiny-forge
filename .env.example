# Copy this file to `.env` and fill in values for your environment.
# Values defined here are picked up automatically by `bin/run_local_auth_stack.py`
# when CLI flags are not provided.

FIREBASE_PROJECT_ID=shiny-demo


# Provide the Firebase web configuration JSON on a single line so it can be
# exported safely through environment variables or secret managers.
FIREBASE_WEB_CONFIG={"apiKey":"AIzaSyD3mo-demoApiKey123","authDomain":"shiny-demo.firebaseapp.com","projectId":"shiny-demo","appId":"1:1234567890:web:abc123def456","messagingSenderId":"1234567890"}

# Optional: list cookie names that should be checked for Firebase ID tokens.
FIREBASE_TOKEN_COOKIE_NAMES=__session,shiny_session

# Optional: path to redirect users to after successful login.
FIREBASE_LOGIN_REDIRECT=/

# Optional: path to a Firebase Admin service-account JSON for local testing.
FIREBASE_CREDENTIALS=C:/path/to/firebase-admin.json

# Optional: point to a running Firebase Auth emulator (host:port).
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
